# Copy to .env and fill in what you need.

# Optional: lets the "New challenge" button ask Claude to write challenges.
ANTHROPIC_API_KEY=
# Model used by the generator.
WHETSTONE_MODEL=claude-sonnet-5-5

# Redis for the distributed-systems challenges. docker compose sets this for you.
REDIS_URL=redis://localhost:6379/0

# Seconds before a test run is stopped (catches deadlocks).
WHETSTONE_RUN_TIMEOUT=60

# Extra host names the app may answer on (comma-separated), e.g. a dev container name.
# Leave empty: by default Whetstone only answers localhost, because it runs the code it is sent.
WHETSTONE_ALLOWED_HOSTS=
